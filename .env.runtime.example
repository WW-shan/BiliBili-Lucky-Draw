# Store the active login session here. Keep this file private and chmod 600.
# A full Cookie header can be used to provide bili_jct for comment/repost actions.
cookie_value=replace-with-current-SESSDATA
DB_HOST=bili-db
PORT=3306
SELENIUM_URL=http://bili-selenium:4444
SELENIUM_SCRIPT_TIMEOUT=90
SHARE_BATCH_LIMIT=20
DETAIL_REQUEST_MIN_SECONDS=3
DETAIL_REQUEST_MAX_SECONDS=6
ACTION_INTERVAL_MINUTES=5
VERIFY_BATCH_LIMIT=20
AUTO_RUN_ON_START=true
IDLE_POLL_SECONDS=30
VERIFICATION_PROXY_URL=http://172.21.0.1:7897
